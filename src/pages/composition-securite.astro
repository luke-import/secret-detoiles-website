---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import ValueCard from '../components/ValueCard.astro';
import Button from '../components/Button.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'composition-securite');
if (!page) throw new Error('Page introuvable dans la collection');
const { data } = page;
---
<BaseLayout title={data.seo.title} description={data.seo.description}>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <SectionEyebrow eyebrow={data.hero.eyebrow} title={data.hero.title} />
        <p class="lead">{data.hero.lead}</p>
      </div>
    </section>

    <section class="contient">
      <SectionEyebrow eyebrow={data.contient.eyebrow} title={data.contient.title} />
      <p class="sub-lead">{data.contient.sub_lead}</p>
      <div class="compo-grid">
        {data.contient.cards.map((card) => (
          <ValueCard tint={card.tint} title={card.title} description={card.description} />
        ))}
      </div>
    </section>

    <section class="exclut">
      <SectionEyebrow eyebrow={data.exclut.eyebrow} title={data.exclut.title} />
      <div class="pills">
        {data.exclut.items.map((item) => (
          <span class="pill"><span class="pill-x" aria-hidden="true">✕</span>{item}</span>
        ))}
      </div>
    </section>

    <section class="dermato">
      <div class="dermato-inner">
        <div class="dermato-icon" aria-hidden="true">✦</div>
        <p class="dermato-eyebrow">{data.dermato.eyebrow}</p>
        <h2 class="dermato-title">{data.dermato.title}</h2>
        <p class="dermato-p">{data.dermato.paragraph}</p>
      </div>
    </section>

    <section class="cta-transition">
      <Button variant="primary" href={data.cta.href}>{data.cta.label}</Button>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero { background: var(--color-cream); padding: 5rem 1.5rem; }
  .page-hero-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .lead {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }

  .contient { background: var(--color-cream-warm); padding: 5rem 1.5rem; }
  .sub-lead {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-text-2);
    text-align: center;
    max-width: 55ch;
    margin: 1rem auto 0;
    line-height: 1.6;
  }
  .compo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: var(--max-width);
    margin: 3rem auto 0;
  }

  .exclut { background: var(--color-cream); padding: 5rem 1.5rem; }
  .pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 800px;
    margin: 3rem auto 0;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    background: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-blue-night);
    font-size: 1rem;
  }
  .pill-x { color: var(--color-coral); }

  .dermato { background: var(--color-cream-warm); padding: 5rem 1.5rem; }
  .dermato-inner {
    max-width: 720px;
    margin: 0 auto;
    background: var(--tint-mint);
    border-radius: var(--radius-2xl);
    padding: 3rem 2rem;
    text-align: center;
  }
  .dermato-icon {
    width: 80px;
    height: 80px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    color: var(--color-mint);
    margin: 0 auto 20px;
  }
  .dermato-eyebrow {
    font-family: var(--font-hand);
    font-size: 2rem;
    color: var(--color-coral);
    line-height: 1;
  }
  .dermato-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    color: var(--color-blue-night);
    line-height: 1.2;
    margin: 4px 0 16px;
  }
  .dermato-p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-text-2);
    line-height: 1.7;
  }

  .cta-transition { background: var(--color-cream); padding: 4rem 1.5rem; text-align: center; }

  @media (min-width: 700px) {
    .compo-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .compo-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
