---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import ValueCard from '../components/ValueCard.astro';
import Button from '../components/Button.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'notre-histoire');
if (!page) throw new Error('Page introuvable dans la collection');
const { data } = page;
---
<BaseLayout title={data.seo.title} description={data.seo.description}>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <SectionEyebrow eyebrow={data.hero.eyebrow} title={data.hero.title} />
        <p class="lead">{data.hero.lead}</p>
      </div>
    </section>

    <section class="recit">
      <div class="recit-inner">
        <SectionEyebrow eyebrow={data.recit.eyebrow} title={data.recit.title} center={false} />
        <div class="recit-body">
          {data.recit.paragraphs.map((paragraph) => <p class="recit-p">{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="convictions">
      <SectionEyebrow eyebrow={data.convictions.eyebrow} title={data.convictions.title} />
      <div class="convictions-grid">
        {data.convictions.cards.map((card) => (
          <ValueCard tint={card.tint} title={card.title} description={card.description} />
        ))}
      </div>
    </section>

    <section class="cta-transition">
      <Button variant="primary" href={data.cta.href}>{data.cta.label}</Button>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero { background: var(--color-cream); padding: 5rem 1.5rem; }
  .page-hero-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .lead {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }

  .recit { background: var(--color-cream-warm); padding: 5rem 1.5rem; }
  .recit-inner { max-width: 780px; margin: 0 auto; }
  .recit-body { margin-top: 2rem; }
  .recit-p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-text-2);
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .recit-p:last-child { margin-bottom: 0; }

  .convictions { background: var(--color-cream); padding: 5rem 1.5rem; }
  .convictions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: var(--max-width);
    margin: 3rem auto 0;
  }

  .cta-transition { background: var(--color-cream-warm); padding: 4rem 1.5rem; text-align: center; }

  @media (min-width: 900px) {
    .convictions-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
