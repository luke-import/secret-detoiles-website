---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import ValueCard from '../components/ValueCard.astro';
import SizeCard from '../components/SizeCard.astro';
import Sparkles from '../components/Sparkles.astro';
---
<BaseLayout>
  <main>
    <!-- SECTION 1 — HERO -->
    <section class="hero">
      <Sparkles density="high" variant="hero" />
      <div class="hero-inner">
        <p class="hero-eyebrow">tout en tendresse</p>
        <h1 class="hero-title">Un cocon de douceur pour bébé</h1>
        <p class="hero-lead">Des couches pensées avec bienveillance, testées sous contrôle dermatologique, sans parfum. Pour accompagner bébé de la naissance à ses premiers pas, tout en douceur.</p>
        <div class="hero-ctas">
          <Button variant="primary" href="/la-gamme">Découvrir la gamme</Button>
          <Button variant="ghost" href="/nos-valeurs">Nos engagements</Button>
        </div>
      </div>
    </section>

    <!-- SECTION 2 — ENGAGEMENTS -->
    <section class="engagements">
      <SectionEyebrow eyebrow="nos engagements" title="Une promesse tenue à chaque change" />
      <div class="engagements-grid">
        <ValueCard tint="mint" title="Testées dermato" description="Chaque référence contrôlée en laboratoire dermatologique pour respecter la peau délicate de bébé." />
        <ValueCard tint="blue-sky" title="Sans parfum" description="Une composition épurée, sans parfum ajouté ni ingrédient superflu." />
        <ValueCard tint="star" title="Absorption longue durée" description="Un cœur absorbant qui garde bébé au sec, du coucher au réveil." />
        <ValueCard tint="peach" title="Protection douce et fiable" description="Des barrières anti-fuites souples pour bouger en toute liberté." />
      </div>
    </section>

    <!-- SECTION 3 — COCON DE DOUCEUR (marque) -->
    <section class="marque">
      <div class="marque-inner">
        <div class="marque-image" role="img" aria-label="Emplacement pour photo maman et bébé">
          <span class="marque-star marque-star-1" aria-hidden="true">✦</span>
          <span class="marque-star marque-star-2" aria-hidden="true">✦</span>
          <span class="marque-star marque-star-3" aria-hidden="true">✧</span>
          <div class="marque-image-icon"><span>📷</span></div>
          <p class="marque-image-note">Emplacement photo maman & bébé</p>
          <p class="marque-image-sub">à remplacer en Phase 6</p>
        </div>
        <div class="marque-content">
          <p class="marque-eyebrow">un cocon de douceur</p>
          <h2 class="marque-title">Née sous une bonne étoile</h2>
          <p class="marque-p">Secret d'étoiles est née d'une conviction simple : les premiers mois de bébé sont précieux. Ils méritent qu'on les entoure de tendresse.</p>
          <p class="marque-p">Chaque couche est pensée comme un petit cocon protecteur : douce sur la peau, fiable au fil des heures, discrète au quotidien. Une promesse tenue, sans compromis.</p>
          <div class="marque-cta">
            <Button variant="ghost" href="/notre-histoire">Découvrir notre histoire</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4 — LA GAMME -->
    <section class="gamme">
      <SectionEyebrow eyebrow="la gamme étoilée" title="Une taille pour chaque étoile" />
      <p class="gamme-lead">De la naissance à l'apprentissage de la propreté, une couche pour chaque étape.</p>
      <div class="gamme-grid">
        <SizeCard size="S" subtitle="Taille 1-2" weight="3 – 6 kg" count={42} />
        <SizeCard size="M" subtitle="Taille 3" weight="5 – 10 kg" count={36} />
        <SizeCard size="L" subtitle="Taille 4" weight="9 – 13 kg" count={32} />
        <SizeCard size="XL" subtitle="Taille 5" weight="12 – 15 kg" count={28} />
        <SizeCard size="XXL" subtitle="Taille 6+" weight="+ 15 kg" count={24} />
      </div>
      <div class="gamme-cta">
        <Button variant="primary" href="/la-gamme">Voir toute la gamme</Button>
      </div>
    </section>

    <!-- SECTION 5 — CTA FINAL -->
    <section class="cta-final">
      <div class="cta-final-inner">
        <Sparkles density="medium" variant="cta" />
        <div class="cta-final-content">
          <p class="cta-final-eyebrow">prêt à embarquer ?</p>
          <h2 class="cta-final-title">Un peu de magie dans le quotidien de bébé</h2>
          <p class="cta-final-lead">Retrouvez bientôt les couches Secret d'étoiles chez vos revendeurs partenaires.</p>
          <Button variant="cream" href="/contact">Nous contacter</Button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ===== SECTION 1 — HERO ===== */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
    background: linear-gradient(180deg, var(--color-cream) 60%, var(--tint-blue-sky) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }
  .hero-eyebrow {
    font-family: var(--font-hand);
    font-size: 2rem;
    color: var(--color-coral);
    line-height: 1;
    margin-bottom: 12px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 4rem);
    color: var(--color-blue-night);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .hero-lead {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 0 auto 32px;
    line-height: 1.7;
  }
  .hero-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===== SECTION 2 — ENGAGEMENTS ===== */
  .engagements {
    padding: 5rem 1.5rem;
  }
  .engagements-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: var(--max-width);
    margin: 3rem auto 0;
  }

  /* ===== SECTION 3 — MARQUE ===== */
  .marque {
    padding: 5rem 1.5rem;
    background: var(--color-cream-warm);
  }
  .marque-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .marque-image {
    position: relative;
    overflow: hidden;
    background: var(--tint-mint);
    border-radius: var(--radius-2xl);
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .marque-star {
    position: absolute;
    line-height: 1;
  }
  .marque-star-1 {
    top: 15%;
    left: 20%;
    color: var(--color-star);
    font-size: 24px;
  }
  .marque-star-2 {
    top: 60%;
    right: 15%;
    color: var(--color-coral);
    font-size: 20px;
  }
  .marque-star-3 {
    bottom: 20%;
    left: 40%;
    color: var(--color-peach);
    font-size: 18px;
  }
  .marque-image-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .marque-image-icon span {
    font-size: 32px;
    opacity: 0.6;
  }
  .marque-image-note {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--color-text-3);
    margin-top: 16px;
    opacity: 0.8;
    text-align: center;
  }
  .marque-image-sub {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-3);
    opacity: 0.6;
    margin-top: 4px;
  }
  .marque-eyebrow {
    font-family: var(--font-hand);
    font-size: 2rem;
    color: var(--color-coral);
    line-height: 1;
  }
  .marque-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--color-blue-night);
    line-height: 1.2;
    margin: 4px 0 24px;
  }
  .marque-p {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-2);
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .marque-cta {
    margin-top: 16px;
  }

  /* ===== SECTION 4 — GAMME ===== */
  .gamme {
    padding: 5rem 1.5rem;
  }
  .gamme-lead {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-text-2);
    text-align: center;
    max-width: 55ch;
    margin: 1rem auto 3rem;
    line-height: 1.6;
  }
  .gamme-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .gamme-cta {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }

  /* ===== SECTION 5 — CTA FINAL ===== */
  .cta-final {
    padding: 5rem 1.5rem;
  }
  .cta-final-inner {
    position: relative;
    overflow: hidden;
    max-width: var(--max-width);
    margin: 0 auto;
    background: linear-gradient(135deg, var(--color-blue-night) 0%, var(--color-blue-night-2) 100%);
    border-radius: var(--radius-2xl);
    padding: 4rem 2rem;
    text-align: center;
  }
  .cta-final-content {
    position: relative;
    z-index: 1;
  }
  .cta-final-eyebrow {
    font-family: var(--font-hand);
    font-size: 2rem;
    color: var(--color-star);
    line-height: 1;
    margin-bottom: 8px;
  }
  .cta-final-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--color-cream);
    line-height: 1.2;
    max-width: 25ch;
    margin: 0 auto 20px;
  }
  .cta-final-lead {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-cream-deep);
    max-width: 40ch;
    margin: 0 auto 32px;
    line-height: 1.6;
    opacity: 0.9;
  }

  /* ===== RESPONSIVE (mobile-first, min-width) ===== */
  @media (min-width: 700px) {
    .hero {
      padding: 8rem 2rem 6rem;
    }
    .engagements-grid {
      grid-template-columns: 1fr 1fr;
    }
    .gamme-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .marque-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
  }

  @media (min-width: 1000px) {
    .engagements-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .gamme-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
