---
import 'leaflet/dist/leaflet.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import Button from '../components/Button.astro';
import { getEntry } from 'astro:content';
import { geocoder } from '../lib/geocodage';
import { ETOILE_PATH, ETOILE_VIEWBOX } from '../lib/etoile';
import {
  TERRITOIRES,
  TYPES_POINT_DE_VENTE,
  libellePointsDeVente,
  telInternational,
  type PointDeVente,
} from '../data/territoires';

const page = await getEntry('pages', 'ou-nous-trouver');
if (!page) throw new Error('Page introuvable dans la collection');
const data = page.data as typeof page.data & {
  hero: { eyebrow: string; title: string; lead: string };
  vide: { message: string; lien_label: string; lien_href: string };
  mention: string;
};

const liste = await getEntry('pointsDeVente', 'points-de-vente');
if (!liste) throw new Error('Liste des points de vente introuvable');

// Ordre du fichier = ordre de la liste (index commun liste ↔ étoile de la carte).
// Position : celle saisie dans Decap si elle existe, sinon géocodage de l'adresse (au build).
const points: PointDeVente[] = await Promise.all(
  liste.data.points.map(async ({ position, ...p }, i) => {
    const pos = position ?? (await geocoder(p.nom, p.adresse, p.codePostal, p.ville));
    return { ...p, id: `pdv-${i + 1}`, lat: pos?.lat ?? null, lng: pos?.lng ?? null };
  }),
);

const territoires = TERRITOIRES.map((t) => ({
  ...t,
  points: points.filter((p) => p.territoire === t.id),
}));

// Données lues par le script client pour la carte (la liste, elle, est déjà dans le HTML).
const donneesCarte = territoires.map((t) => ({
  id: t.id,
  couleur: t.couleur,
  center: t.center,
  zoom: t.zoom,
  carte: t.carte,
  points: t.points.map((p) => ({
    nom: p.nom,
    type: TYPES_POINT_DE_VENTE[p.type],
    adresse: p.adresse,
    ville: `${p.codePostal} ${p.ville}`,
    lat: p.lat,
    lng: p.lng,
  })),
}));
const donneesJson = JSON.stringify(donneesCarte).replace(/</g, '\\u003c');

// En-têtes : « Bientôt disponible » plutôt que « 0 point de vente ».
const compteur = (n: number) => (n > 0 ? libellePointsDeVente(n) : 'Bientôt disponible');

---
<BaseLayout title={data.seo.title} description={data.seo.description}>
  <main>
    <section class="pdv" data-pdv>
      <div class="pdv-inner">
        <div class="pdv-head">
          <SectionEyebrow eyebrow={data.hero.eyebrow} title={data.hero.title} />
          <p class="lead">{data.hero.lead}</p>
        </div>

        {/* ── Vue sélecteur (état initial) ── */}
        <div class="selector" data-selector>
          {territoires.map((t) => (
            <button type="button" class={`t-card t-${t.couleur}`} data-open={t.id}>
              <span class="t-star-small" aria-hidden="true">✦</span>
              <span class="t-star-big" aria-hidden="true">✦</span>
              <span class="t-nom">{t.nom}</span>
              <span class="t-region">{t.region}</span>
              <span class="t-foot">
                <span class="t-count">
                  {t.points.length === 0 && <span class="t-count-star" aria-hidden="true">✦</span>}
                  {compteur(t.points.length)}
                </span>
                <span class="t-arrow" aria-hidden="true">→</span>
              </span>
            </button>
          ))}
        </div>

        {/* ── Vue territoire (après clic) ── */}
        <div class="territory" data-territory hidden>
          <div class="tabs" role="group" aria-label="Choisir un territoire">
            <button type="button" class="tab-all" data-all>← Tous les territoires</button>
            {territoires.map((t) => (
              <button type="button" class={`tab t-${t.couleur}`} data-tab={t.id} aria-pressed="false">
                <span class="dot" aria-hidden="true"></span>
                {t.nom}
              </button>
            ))}
          </div>

          <div class="layout">
            <div class="panel">
              {territoires.map((t) => (
                <div class={`list-panel t-${t.couleur}`} data-panel={t.id} hidden>
                  <div class="panel-head">
                    <h3>{t.nom}</h3>
                    <p>{compteur(t.points.length)}</p>
                  </div>
                  {t.points.length > 0 ? (
                    <ol class="list" data-list>
                      {t.points.map((p, i) => (
                        <li class="item" data-index={i}>
                          <svg class="puce" viewBox={ETOILE_VIEWBOX} aria-hidden="true"><path d={ETOILE_PATH} /></svg>
                          <div class="item-body">
                            <h4 class="item-nom">
                              <button type="button" class="item-btn" data-item={i}>{p.nom}</button>
                            </h4>
                            <p class="item-type">{TYPES_POINT_DE_VENTE[p.type]}</p>
                            <p class="item-adr">{p.adresse}<br />{p.codePostal} {p.ville}</p>
                            {p.horaires && <p class="item-horaires">{p.horaires}</p>}
                            {p.telephone && <a class="item-tel" href={telInternational(p.telephone, t.indicatif)}>{p.telephone}</a>}
                          </div>
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <div class="empty">
                      <p class="empty-title">Pas encore de point de vente {t.prep}</p>
                      <p class="empty-text">{data.vide.message}</p>
                      <Button href={data.vide.lien_href}>{data.vide.lien_label}</Button>
                    </div>
                  )}
                </div>
              ))}
            </div>

            <div class="map-wrap">
              <div class="map" data-map role="region" aria-label="Carte des points de vente"></div>
              {territoires.filter((t) => t.points.length === 0).map((t) => (
                <p class={`map-soon t-${t.couleur}`} data-soon={t.id} hidden>
                  <span class="map-soon-star" aria-hidden="true">✦</span> Bientôt disponible {t.prep}
                </p>
              ))}
            </div>
          </div>

          <p class="mention">{data.mention}</p>
        </div>
      </div>
    </section>
  </main>
  <script type="application/json" id="pdv-data" set:html={donneesJson} />
</BaseLayout>

<script>
  import type { LatLngBoundsExpression, LayerGroup, Map as CarteLeaflet, Marker, Popup } from 'leaflet';
  import type { Flavor } from '@protomaps/basemaps';
  import { ETOILE_PATH, ETOILE_VIEWBOX } from '../lib/etoile';
  import { CARTES_VERSION, PAYS_VERS_TERRITOIRE, type TerritoireId } from '../data/territoires';

  interface PointCarte {
    nom: string;
    type: string;
    adresse: string;
    ville: string;
    lat: number | null; // null : adresse introuvable → dans la liste, sans étoile
    lng: number | null;
  }
  interface TerritoireCarte {
    id: TerritoireId;
    couleur: string;
    center: [number, number];
    zoom: number;
    carte: { bbox: [number, number, number, number]; maxzoom: number };
    points: PointCarte[];
  }

  // Une étoile vide (sans chiffre) par pharmacie, à son emplacement exact, à tous les zooms.
  const TAILLE_ETOILE = 32;
  const etoile = (couleur: string) =>
    `<span class="pdv-etoile t-${couleur}"><svg viewBox="${ETOILE_VIEWBOX}" aria-hidden="true">` +
    `<path d="${ETOILE_PATH}"/></svg></span>`;
  // Pharmacie sélectionnée : zoom jusqu'à ce que ses voisines soient au moins à cet écart (en px,
  // centre à centre) pour la distinguer, sans dépasser ZOOM_MAX_AUTO (adresses quasi identiques).
  const ECART_MIN = 44;
  const ZOOM_MAX_AUTO = 17;
  // Clic dans la liste : on zoome au moins jusqu'à la vue de quartier.
  const ZOOM_LISTE = 13;

  // Fond de carte aux couleurs du site : lues dans les tokens CSS (le canvas Protomaps attend des couleurs résolues).
  const token = (nom: string) => getComputedStyle(document.documentElement).getPropertyValue(nom).trim();
  const melange = (a: string, b: string, partB: number) => {
    const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
    const [ca, cb] = [rgb(a), rgb(b)];
    return `#${ca.map((v, i) => Math.round(v + (cb[i] - v) * partB).toString(16).padStart(2, '0')).join('')}`;
  };

  const root = document.querySelector<HTMLElement>('[data-pdv]');
  const brut = document.getElementById('pdv-data')?.textContent;

  if (root && brut) {
    const territoires = JSON.parse(brut) as TerritoireCarte[];
    const selector = root.querySelector<HTMLElement>('[data-selector]')!;
    const territory = root.querySelector<HTMLElement>('[data-territory]')!;
    const mapEl = root.querySelector<HTMLElement>('[data-map]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const soon = [...root.querySelectorAll<HTMLElement>('[data-soon]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let courant: TerritoireCarte | null = null;
    // Dès que le visiteur choisit lui-même, la géoloc ne doit plus rien basculer.
    let choixVisiteur = false;
    let marqueurs: (Marker | undefined)[] = []; // undefined : pharmacie sans position
    // Une popup par pharmacie, NON liée à son marqueur : on l'ouvre nous-mêmes (carte.openPopup) une fois
    // le zoom terminé, sinon le recadrage automatique de Leaflet entrerait en conflit avec le zoom.
    let popups: (Popup | undefined)[] = [];

    // ── Carte : une seule instance, créée au premier affichage ──
    type Fond = ReturnType<typeof import('protomaps-leaflet').leafletLayer>;
    let cartePromise: Promise<{
      carte: CarteLeaflet;
      calque: LayerGroup;
      L: typeof import('leaflet');
      fondPour: (t: TerritoireCarte) => Fond;
      eau: string;
    }> | null = null;
    let fondActif: Fond | null = null;
    const obtenirCarte = () => {
      cartePromise ??= import('leaflet').then(async (module) => {
        // protomaps-leaflet s'appuie sur la variable globale L : on la lui fournit,
        // sous forme d'objet modifiable (un module ES importé ne l'est pas).
        const L = { ...module } as typeof module;
        (window as unknown as { L: typeof module }).L = L;
        const [protomaps, { namedFlavor }] = await Promise.all([import('protomaps-leaflet'), import('@protomaps/basemaps')]);
        // maxBoundsViscosity 1 : impossible de tirer la carte au-delà de l'emprise, même brièvement.
        const carte = L.map(mapEl, { scrollWheelZoom: false, maxZoom: 18, maxBoundsViscosity: 1 });

        // Flavor « light » de Protomaps, recoloré : terre crème, eau bleu ciel, routes blanches,
        // ni relief, ni végétation colorée, ni POI.
        const terre = token('--color-cream');
        const bordure = token('--color-cream-deep');
        const eau = melange(token('--tint-blue-sky'), token('--color-blue-sky'), 0.35);
        const texte = token('--color-text-2');
        const base = namedFlavor('light');
        const sol = Object.fromEntries(
          (['earth', 'park_a', 'park_b', 'hospital', 'industrial', 'school', 'wood_a', 'wood_b', 'pedestrian',
            'scrub_a', 'scrub_b', 'glacier', 'sand', 'beach', 'aerodrome', 'zoo', 'military'] as const).map((k) => [k, terre]),
        );
        const routes = Object.fromEntries(
          (Object.keys(base) as (keyof Flavor)[])
            .filter((k) => /^(tunnel_|bridges_)?(other|minor|minor_a|minor_b|minor_service|link|major|highway|pier|runway)$/.test(k))
            .map((k) => [k, '#fff']),
        );
        const bords = Object.fromEntries(
          (Object.keys(base) as (keyof Flavor)[]).filter((k) => k.includes('casing')).map((k) => [k, bordure]),
        );
        const labels = Object.fromEntries(
          (Object.keys(base) as (keyof Flavor)[])
            .filter((k) => k.endsWith('_label'))
            .map((k) => [k, texte]),
        );
        const halos = Object.fromEntries(
          (Object.keys(base) as (keyof Flavor)[]).filter((k) => k.endsWith('_halo')).map((k) => [k, terre]),
        );
        const flavor: Flavor = {
          ...base,
          ...sol,
          ...routes,
          ...bords,
          ...labels,
          ...halos,
          background: eau,
          water: eau,
          buildings: bordure,
          railway: bordure,
          boundaries: melange(bordure, texte, 0.3),
          landcover: undefined,
          pois: undefined,
        };
        const regles = { paintRules: protomaps.paintRules(flavor), labelRules: protomaps.labelRules(flavor, 'fr') };

        // Tuiles statiques par territoire, servies depuis le site (aucun appel externe).
        // La marge autour de l'emprise extraite n'a pas de tuiles : elle prend la couleur de l'eau.
        mapEl.style.backgroundColor = eau;
        const fonds = new Map<TerritoireId, Fond>();
        const fondPour = (t: TerritoireCarte) => {
          let fond = fonds.get(t.id);
          if (!fond) {
            const [ouest, sud, est, nord] = t.carte.bbox;
            fond = protomaps.leafletLayer({
              url: `/cartes/${CARTES_VERSION}/${t.id}/{z}/{x}/{y}.pbf`,
              // Aucune requête hors de l'emprise : une tuile absente renverrait la page 404 du site.
              bounds: [[sud, ouest], [nord, est]],
              ...regles,
              backgroundColor: eau,
              maxDataZoom: t.carte.maxzoom,
              maxZoom: 18,
              attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors · <a href="https://protomaps.com">Protomaps</a>',
            });
            fonds.set(t.id, fond);
          }
          return fond;
        };
        // Zoom molette seulement après un clic sur la carte : évite de piéger le scroll de la page.
        carte.on('click', () => carte.scrollWheelZoom.enable());
        carte.on('mouseout', () => carte.scrollWheelZoom.disable());
        const calque = L.layerGroup().addTo(carte);
        return { carte, calque, L, fondPour, eau };
      });
      return cartePromise;
    };

    let carteCourante: CarteLeaflet | null = null;

    const ouvrirPopup = (i: number) => {
      const popup = popups[i];
      if (popup && carteCourante) carteCourante.openPopup(popup);
    };

    const panneauActif = () => panels.find((p) => p.dataset.panel === courant?.id);

    // Étoile active (pharmacie sélectionnée) : bleu nuit, opaque, agrandie et AU-DESSUS des autres
    // (z-index), y compris quand elle chevauche ses voisines.
    let indexActif: number | null = null;
    const majEtoilesActives = () => {
      marqueurs.forEach((m, i) => {
        if (!m) return;
        const actif = i === indexActif;
        m.getElement()?.classList.toggle('is-actif', actif);
        m.setZIndexOffset(actif ? 10000 : 0);
      });
    };

    const activerItem = (index: number, defiler: boolean) => {
      indexActif = index;
      majEtoilesActives();
      const panneau = panneauActif();
      if (!panneau) return;
      panneau.querySelectorAll<HTMLElement>('.item').forEach((li) => {
        li.classList.toggle('is-active', Number(li.dataset.index) === index);
      });
      const liste = panneau.querySelector<HTMLElement>('[data-list]');
      const li = liste?.querySelector<HTMLElement>(`.item[data-index="${index}"]`);
      if (defiler && liste && li) {
        liste.scrollTo({ top: li.offsetTop - 12, behavior: reduceMotion ? 'auto' : 'smooth' });
      }
    };

    const contenuPopup = (p: PointCarte) => {
      const el = document.createElement('div');
      el.className = 'pdv-popup';
      const nom = document.createElement('strong');
      nom.textContent = p.nom;
      const type = document.createElement('span');
      type.className = 'pdv-popup-type';
      type.textContent = p.type;
      const adr = document.createElement('span');
      adr.className = 'pdv-popup-adr';
      adr.append(p.adresse, document.createElement('br'), p.ville);
      const lien = document.createElement('a');
      lien.href = `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}`;
      lien.target = '_blank';
      lien.rel = 'noopener';
      lien.textContent = 'Itinéraire →';
      el.append(nom, type, adr, lien);
      return el;
    };

    const afficherPins = async (t: TerritoireCarte) => {
      const { carte, calque, L, fondPour } = await obtenirCarte();
      if (courant !== t) return; // le visiteur a changé de territoire entre-temps
      carte.invalidateSize();
      // Limites levées le temps de recentrer, puis recalées sur l'emprise du territoire.
      carte.setMaxBounds(undefined as unknown as LatLngBoundsExpression);
      carte.setMinZoom(0);
      calque.clearLayers();
      carte.closePopup(); // la popup n'est pas liée au marqueur : elle ne se ferme pas avec lui

      // Fond du territoire : on remplace le calque, la carte reste la même.
      const fond = fondPour(t);
      if (fondActif !== fond) {
        if (fondActif) carte.removeLayer(fondActif);
        fond.addTo(carte);
        fond.bringToBack();
        fondActif = fond;
      }

      indexActif = null;
      popups = [];
      carteCourante = carte;
      marqueurs = t.points.map((p, i) => {
        if (p.lat === null || p.lng === null) return undefined; // adresse introuvable : pas d'étoile
        const { lat, lng } = p;
        // Étoile vide posée sur l'adresse (ancre au centre) ; infobulle avec le nom au survol.
        const m = L.marker([lat, lng], {
          icon: L.divIcon({
            className: 'pdv-pin-icon',
            html: etoile(t.couleur),
            iconSize: [TAILLE_ETOILE, TAILLE_ETOILE],
            iconAnchor: [TAILLE_ETOILE / 2, TAILLE_ETOILE / 2],
          }),
        });
        // Popup juste au-dessus de l'étoile, NON liée au marqueur (ouverte après le zoom).
        popups[i] = L.popup({ offset: [0, -TAILLE_ETOILE / 2] }).setLatLng([lat, lng]).setContent(contenuPopup(p));
        return m
          .bindTooltip(p.nom, { direction: 'top', offset: [0, -TAILLE_ETOILE / 2], className: 'pdv-infobulle' })
          .on('click', () => void selectionner(i, 0, true))
          .on('add', () => {
            m.getElement()?.setAttribute('aria-label', p.nom); // nom lu par les lecteurs d'écran
            majEtoilesActives();
          })
          .addTo(calque);
      });
      // Limites de déplacement, posées AVANT le recentrage qui s'y plie.
      // Au-delà de l'emprise c'est la mer, de la couleur du fond → marge de 10 %, invisible.
      const [ouest, sud, est, nord] = t.carte.bbox;
      const limites = L.latLngBounds([sud, ouest], [nord, est]).pad(0.1);
      carte.setMinZoom(Math.max(0, carte.getBoundsZoom(limites) - 1));
      carte.setMaxBounds(limites);
      const places = t.points.flatMap((p) => (p.lat !== null && p.lng !== null ? [[p.lat, p.lng] as [number, number]] : []));
      if (places.length > 0) {
        carte.fitBounds(L.latLngBounds(places), { padding: [48, 48], maxZoom: 14 });
      } else {
        carte.setView(t.center, t.zoom);
      }
    };

    // Zoom minimal pour que l'étoile i soit à au moins ECART_MIN px de toutes ses voisines.
    // L'écart double à chaque cran de zoom : on le calcule depuis l'écart au zoom courant.
    const zoomPourDistinguer = (carte: CarteLeaflet, t: TerritoireCarte, i: number, plancher: number) => {
      const p = t.points[i];
      const zc = carte.getZoom();
      let z = Math.max(zc, plancher);
      if (!p || p.lat === null || p.lng === null) return z;
      const a = carte.project([p.lat, p.lng], zc);
      t.points.forEach((q, j) => {
        if (j === i || q.lat === null || q.lng === null) return;
        const d = a.distanceTo(carte.project([q.lat, q.lng], zc));
        if (d > 0 && d < ECART_MIN) z = Math.max(z, Math.ceil(zc + Math.log2(ECART_MIN / d)));
      });
      return Math.min(z, Math.max(ZOOM_MAX_AUTO, zc));
    };

    // Sélection d'une pharmacie (clic sur l'étoile ou dans la liste) : étoile active, zoom si
    // nécessaire pour la distinguer de ses voisines, puis popup.
    const selectionner = async (i: number, plancher: number, defiler: boolean) => {
      activerItem(i, defiler);
      const t = courant;
      const p = t?.points[i];
      if (!t || !p || p.lat === null || p.lng === null) return; // sans position : rien sur la carte
      const { carte } = await obtenirCarte();
      if (courant !== t) return;
      const z = zoomPourDistinguer(carte, t, i, plancher);
      if (z > carte.getZoom()) {
        carte.once('moveend', () => ouvrirPopup(i));
        carte.setView([p.lat, p.lng], z);
      } else {
        ouvrirPopup(i); // la popup recadre la carte si besoin
      }
    };

    const majUrl = (id: TerritoireId | null) => {
      const url = new URL(window.location.href);
      if (id) url.searchParams.set('territoire', id);
      else url.searchParams.delete('territoire');
      history.replaceState(null, '', url);
    };

    const ouvrir = (id: TerritoireId, { focusOnglet = false } = {}) => {
      const t = territoires.find((x) => x.id === id);
      if (!t) return;
      courant = t;
      selector.hidden = true;
      territory.hidden = false;
      tabs.forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.tab === id)));
      soon.forEach((el) => (el.hidden = el.dataset.soon !== id));
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== id;
        p.querySelectorAll('.item.is-active').forEach((li) => li.classList.remove('is-active'));
        p.querySelector('[data-list]')?.scrollTo({ top: 0 });
      });
      majUrl(id);
      if (focusOnglet) tabs.find((tab) => tab.dataset.tab === id)?.focus();
      void afficherPins(t);
    };

    const revenirAuSelecteur = () => {
      const precedent = courant?.id;
      courant = null;
      territory.hidden = true;
      selector.hidden = false;
      majUrl(null);
      selector.querySelector<HTMLButtonElement>(`[data-open="${precedent}"]`)?.focus();
    };

    // ── Interactions ──
    selector.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        choixVisiteur = true;
        ouvrir(btn.dataset.open as TerritoireId, { focusOnglet: true });
      }),
    );
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        choixVisiteur = true;
        ouvrir(tab.dataset.tab as TerritoireId);
      }),
    );
    root.querySelector('[data-all]')?.addEventListener('click', () => {
      choixVisiteur = true; // « Tous les territoires » ne relance pas la géoloc
      revenirAuSelecteur();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-item]').forEach((btn) =>
      btn.addEventListener('click', () => void selectionner(Number(btn.dataset.item), ZOOM_LISTE, false)),
    );

    // ── Au chargement : ?territoire → géoloc IP (ou ?geo simulé) → sélecteur ──
    const params = new URLSearchParams(window.location.search);
    const estTerritoire = (v: string | null | undefined): v is TerritoireId =>
      territoires.some((t) => t.id === v);

    const detecterPays = async (): Promise<string | null> => {
      const simule = params.get('geo');
      if (simule) return simule.toUpperCase();
      const controleur = new AbortController();
      const minuteur = window.setTimeout(() => controleur.abort(), 1500);
      try {
        // POST : jamais mis en cache par Cloudflare (voir functions/api/geo.ts).
        const res = await fetch('/api/geo', { method: 'POST', signal: controleur.signal, cache: 'no-store' });
        if (!res.ok) return null;
        const json = (await res.json()) as { country?: unknown };
        return typeof json.country === 'string' ? json.country : null;
      } catch {
        return null; // erreur réseau, timeout, réponse non JSON (ex. en local)
      } finally {
        window.clearTimeout(minuteur);
      }
    };

    const depuisUrl = params.get('territoire');
    if (estTerritoire(depuisUrl)) {
      ouvrir(depuisUrl);
    } else {
      // Le sélecteur est déjà affiché : pas d'écran blanc pendant l'appel.
      void detecterPays().then((pays) => {
        const id = pays ? PAYS_VERS_TERRITOIRE[pays] : undefined;
        if (id && !choixVisiteur) ouvrir(id);
      });
    }
  }
</script>

