---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Button from '../components/Button.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'faq');
if (!page) throw new Error('Page introuvable dans la collection');
const { data } = page;
---
<BaseLayout title={data.seo.title} description={data.seo.description}>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <SectionEyebrow eyebrow={data.hero.eyebrow} title={data.hero.title} />
        <p class="lead">{data.hero.lead}</p>
      </div>
    </section>

    <section class="faq-section">
      <div class="faq-inner">
        {data.questions.map((item) => (
          <FaqAccordion question={item.question} open={item.open}>
            {item.answer.map((paragraph) => <p>{paragraph}</p>)}
          </FaqAccordion>
        ))}
      </div>
    </section>

    <section class="cta-transition">
      <p class="cta-lead">{data.cta.lead}</p>
      <Button variant="primary" href={data.cta.href}>{data.cta.label}</Button>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero { background: var(--color-cream); padding: 5rem 1.5rem; }
  .page-hero-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .lead {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }

  .faq-section { background: var(--color-cream-warm); padding: 5rem 1.5rem; }
  .faq-inner { max-width: 780px; margin: 0 auto; }

  .cta-transition { background: var(--color-cream); padding: 4rem 1.5rem; text-align: center; }
  .cta-lead {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-text-2);
    margin-bottom: 20px;
  }
</style>
