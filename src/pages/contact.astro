---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Contact — Secret d'étoiles" description="Contactez l'équipe Secret d'étoiles par email ou via notre formulaire.">
  <main class="stub-page">
    <SectionEyebrow eyebrow="écrivez-nous" title="On adore vous lire" />
    <p class="lead">Notre page contact complète arrive bientôt. En attendant, écrivez-nous directement à bonjour@secret-detoiles.fr.</p>
    <div class="cta"><Button variant="primary" href="/">Retour à l'accueil</Button></div>
  </main>
</BaseLayout>

<style>
  .stub-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .lead {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 2rem auto 3rem;
    line-height: 1.7;
  }
  .cta { display: flex; justify-content: center; }
</style>
