---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout title="Contact — Secret d'étoiles" description="Contactez l'équipe Secret d'étoiles : écrivez-nous à bonjour@secret-detoiles.fr ou via notre formulaire.">
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <SectionEyebrow eyebrow="écrivez-nous" title="On adore vous lire" />
        <p class="lead">Une question, une remarque, une envie de discuter ? Cette adresse est la vôtre. Nous vous répondons personnellement et rapidement.</p>
      </div>
    </section>

    <section class="form-section">
      <div class="form-inner">
        <SectionEyebrow eyebrow="ou via le formulaire" title="Envoyez-nous un message" />
        <div class="form-wrap">
          <ContactForm />
        </div>
      </div>
    </section>

    <section class="trouver">
      <SectionEyebrow eyebrow="où nous trouver" title="Bientôt chez vos revendeurs partenaires" />
      <p class="lead">Nos couches seront prochainement disponibles chez une sélection de revendeurs. Contactez-nous par email pour connaître le point de vente le plus proche.</p>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero { background: var(--color-cream); padding: 5rem 1.5rem; }
  .page-hero-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .lead {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }

  .form-section { background: var(--color-cream); padding: 5rem 1.5rem; }
  .form-inner { max-width: 720px; margin: 0 auto; }
  .form-wrap { margin-top: 3rem; }

  .trouver { background: var(--color-cream-warm); padding: 5rem 1.5rem; text-align: center; }
</style>
