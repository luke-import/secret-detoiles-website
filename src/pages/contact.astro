---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import ContactForm from '../components/ContactForm.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Page introuvable dans la collection');
const { data } = page;
---
<BaseLayout title={data.seo.title} description={data.seo.description}>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <SectionEyebrow eyebrow={data.hero.eyebrow} title={data.hero.title} />
        <p class="lead">{data.hero.lead}</p>
      </div>
    </section>

    <section class="form-section">
      <div class="form-inner">
        <SectionEyebrow eyebrow={data.form.eyebrow} title={data.form.title} />
        <div class="form-wrap">
          <ContactForm />
        </div>
      </div>
    </section>

    <section class="trouver">
      <SectionEyebrow eyebrow={data.trouver.eyebrow} title={data.trouver.title} />
      <p class="lead">{data.trouver.lead}</p>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero { background: var(--color-cream); padding: 5rem 1.5rem; }
  .page-hero-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .lead {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }

  .form-section { background: var(--color-cream); padding: 5rem 1.5rem; }
  .form-inner { max-width: 720px; margin: 0 auto; }
  .form-wrap { margin-top: 3rem; }

  .trouver { background: var(--color-cream-warm); padding: 5rem 1.5rem; text-align: center; }
</style>
