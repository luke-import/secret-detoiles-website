---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import Button from '../components/Button.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'nos-valeurs');
if (!page) throw new Error('Page introuvable dans la collection');
const { data } = page;
---
<BaseLayout title={data.seo.title} description={data.seo.description}>
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <SectionEyebrow eyebrow={data.hero.eyebrow} title={data.hero.title} />
        <p class="lead">{data.hero.lead}</p>
      </div>
    </section>

    {data.engagements.map((eng) => (
      <section class="engagement" data-bg={eng.bg}>
        <div class="engagement-inner">
          <div class="eng-num" data-tint={eng.tint} aria-hidden="true">{eng.num}</div>
          <div class="eng-content">
            <p class="eng-eyebrow">{eng.eyebrow}</p>
            <h2 class="eng-title">{eng.title}</h2>
            <p class="eng-p">{eng.p1}</p>
            <p class="eng-p">{eng.p2}</p>
          </div>
        </div>
      </section>
    ))}

    <section class="cta-transition">
      <Button variant="primary" href={data.cta.href}>{data.cta.label}</Button>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero { background: var(--color-cream); padding: 5rem 1.5rem; }
  .page-hero-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .lead {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }

  .engagement { padding: 5rem 1.5rem; }
  .engagement[data-bg='cream'] { background: var(--color-cream); }
  .engagement[data-bg='cream-warm'] { background: var(--color-cream-warm); }
  .engagement-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .eng-num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1;
  }
  .eng-num[data-tint='mint'] { color: var(--color-mint); }
  .eng-num[data-tint='blue-sky'] { color: var(--color-blue-sky); }
  .eng-num[data-tint='star'] { color: var(--color-star); }
  .eng-num[data-tint='peach'] { color: var(--color-peach); }
  .eng-eyebrow {
    font-family: var(--font-hand);
    font-size: 2rem;
    color: var(--color-coral);
    line-height: 1;
  }
  .eng-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    color: var(--color-blue-night);
    line-height: 1.2;
    margin: 4px 0 20px;
  }
  .eng-p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-text-2);
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .eng-p:last-child { margin-bottom: 0; }

  .cta-transition { background: var(--color-cream); padding: 4rem 1.5rem; text-align: center; }

  @media (min-width: 800px) {
    .engagement-inner {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 40px;
      align-items: start;
    }
  }
</style>
