---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Nos valeurs — Secret d'étoiles" description="Testées dermato, sans parfum, absorption longue durée : nos 4 engagements pour bébé.">
  <main class="stub-page">
    <SectionEyebrow eyebrow="nos engagements" title="Une promesse tenue à chaque change" />
    <p class="lead">Nos 4 engagements présentés en détail seront très bientôt en ligne.</p>
    <div class="cta"><Button variant="primary" href="/">Retour à l'accueil</Button></div>
  </main>
</BaseLayout>

<style>
  .stub-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .lead {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--color-text-2);
    max-width: 55ch;
    margin: 2rem auto 3rem;
    line-height: 1.7;
  }
  .cta { display: flex; justify-content: center; }
</style>
