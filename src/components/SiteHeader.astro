---
// Liens de navigation principaux (réutilisés en desktop et mobile).
const links = [
  { href: '/', label: 'Accueil' },
  { href: '/notre-histoire', label: 'Notre histoire' },
  { href: '/la-gamme', label: 'La gamme' },
  { href: '/nos-valeurs', label: 'Nos valeurs' },
  { href: '/composition-securite', label: 'Composition' },
  { href: '/faq', label: 'FAQ' },
];
---
<header class="site-header" role="banner">
  <div class="inner container">
    <a href="/" class="logo" aria-label="Secret d'étoiles — accueil">
      <img src="/uploads/logo-navbar.svg" alt="Secret d'étoiles" width="180" height="40" />
    </a>

    <nav class="menu-desktop" aria-label="Navigation principale">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a href="/contact" class="cta-desktop">Nous contacter</a>

    <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

{/*
  Le menu mobile est volontairement HORS du <header>. Le header porte
  backdrop-filter (blur) ; or un élément avec backdrop-filter devient le bloc
  conteneur de ses descendants position:fixed. Imbriqué, le menu se calait donc
  sur la barre du header (~68px) au lieu du plein écran → fond transparent.
  Placé en frère du header, son inset:0 couvre bien tout le viewport.
  inert par défaut = menu inaccessible au clavier/lecteurs d'écran tant qu'il est fermé.
*/}
<nav id="mobile-menu" class="menu-mobile" aria-label="Navigation principale" data-open="false" inert>
  <button class="close" aria-label="Fermer le menu">×</button>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
  <a href="/contact">Nous contacter</a>
</nav>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('.close');

  if (burger && menu && closeBtn) {
    const setOpen = (open: boolean) => {
      menu.dataset.open = String(open);
      burger.setAttribute('aria-expanded', String(open));
      // inert quand fermé : sort les liens de l'ordre de tabulation et de l'arbre d'accessibilité.
      if (open) menu.removeAttribute('inert');
      else menu.setAttribute('inert', '');
      // Empêche le scroll de la page quand le menu plein écran est ouvert.
      document.body.style.overflow = open ? 'hidden' : '';
    };

    burger.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));
    closeBtn.addEventListener('click', () => setOpen(false));

    // Fermeture au clic sur un lien du menu mobile.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

    // Fermeture avec la touche Échap.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.dataset.open === 'true') setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface-frosted);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-cream-deep);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .logo {
    display: block;
    text-decoration: none;
  }
  .logo img {
    display: block;
    height: 40px;
    width: auto;
    flex-shrink: 0;
  }

  .menu-desktop {
    display: none;
  }

  .cta-desktop {
    display: none;
  }

  .burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 10px;
    cursor: pointer;
  }
  .burger span {
    width: 24px;
    height: 2px;
    background: var(--color-blue-night);
    border-radius: 2px;
    transition: 0.2s;
  }

  .menu-mobile {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-cream);
    padding: 100px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  .menu-mobile[data-open='true'] {
    transform: translateX(0);
  }
  .menu-mobile a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--color-blue-night);
    text-decoration: none;
    padding: 8px 0;
  }

  .close {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 2rem;
    background: none;
    border: none;
    color: var(--color-blue-night);
    cursor: pointer;
    line-height: 1;
  }

  @media (min-width: 900px) {
    .menu-desktop {
      display: flex;
      gap: 28px;
    }
    .menu-desktop a {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 0.95rem;
      color: var(--color-blue-night);
      text-decoration: none;
      padding: 6px 0;
      transition: 0.2s;
    }
    .menu-desktop a:hover {
      color: var(--color-coral);
    }
    .cta-desktop {
      display: inline-flex;
      align-items: center;
      padding: 10px 22px;
      border-radius: var(--radius-pill);
      background: var(--color-blue-night);
      color: var(--color-cream);
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      transition: 0.2s;
    }
    .cta-desktop:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-primary-hover);
    }
    .burger,
    .menu-mobile,
    .close {
      display: none;
    }
  }
</style>
