---
interface Props {
  tint: 'blue-sky' | 'mint' | 'star' | 'peach' | 'coral';
  title: string;
  description: string;
  icon?: string;
}

const { tint, title, description, icon = '✦' } = Astro.props;
---
<article class="value-card" data-tint={tint}>
  <div class="icon">{icon}</div>
  <h3 class="title">{title}</h3>
  <p class="desc">{description}</p>
</article>

<style>
  .value-card {
    border-radius: var(--radius-lg);
    padding: 30px 28px;
  }
  .value-card[data-tint='blue-sky'] { background: var(--tint-blue-sky); }
  .value-card[data-tint='mint'] { background: var(--tint-mint); }
  .value-card[data-tint='star'] { background: var(--tint-star); }
  .value-card[data-tint='peach'] { background: var(--tint-peach); }
  .value-card[data-tint='coral'] { background: var(--tint-coral); }

  .icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 16px;
  }
  .value-card[data-tint='blue-sky'] .icon { color: var(--color-blue-sky); }
  .value-card[data-tint='mint'] .icon { color: var(--color-mint); }
  .value-card[data-tint='star'] .icon { color: var(--color-star); }
  .value-card[data-tint='peach'] .icon { color: var(--color-peach); }
  .value-card[data-tint='coral'] .icon { color: var(--color-coral); }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-blue-night);
    margin-bottom: 8px;
  }
  .desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-2);
  }
</style>
