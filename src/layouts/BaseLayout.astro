---
import '@fontsource/sacramento';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/nunito';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Secret d'étoiles — Les couches enchantées",
  description = "Des couches douces, testées sous contrôle dermatologique. Un cocon de tendresse pour bébé, du premier au dernier change."
} = Astro.props;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>
